{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "buildCommand": "DJANGO_SETTINGS_MODULE=config.settings.prod python backend/manage.py collectstatic --noinput"
}
